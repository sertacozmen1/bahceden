# Bahçeden API: ortam değişkenleri (ÖRNEK DOSYA)
#
# Bu dosya depoya girer ve yalnızca PLACEHOLDER değer içerir. Gerçek değerler
# `.env` dosyasına yazılır ve `.env` gitignore'dadır: ne commit'e ne AI
# bağlamına girer (AGENTS.md K10).
#
# Her değişken tanımsızsa uygulama ayağa kalkmaz; varsayılan secret yoktur.

# ── Veritabanı ──────────────────────────────────────────────
# Geliştirmede docker-compose bu değerleri kendi içinde tanımlar; aşağıdaki
# örnek, api'yi compose dışında çalıştırmak isteyenler içindir.
BAHCEDEN_DB_URL=jdbc:postgresql://localhost:5432/bahceden
BAHCEDEN_DB_USERNAME=bahceden
BAHCEDEN_DB_PASSWORD=degistirin-bu-degeri

# ── CORS ────────────────────────────────────────────────────
# web uygulamasının adresi. Joker karakter (*) kullanılmaz (AGENTS.md §11.6).
BAHCEDEN_WEB_ORIGIN=http://localhost:3000

# ── E-posta (SMTP) ──────────────────────────────────────────
# Sağlayıcıdan bağımsızdır: geliştirmede mailpit, üretimde gerçek SMTP sunucusu.
# Kullanıcı adı ve parola gerekmiyorsa boş bırakılır (mailpit kimlik istemez).
BAHCEDEN_SMTP_HOST=localhost
BAHCEDEN_SMTP_PORT=1025
BAHCEDEN_SMTP_USERNAME=
BAHCEDEN_SMTP_PASSWORD=degistirin-bu-degeri
BAHCEDEN_SMTP_AUTH=false
BAHCEDEN_SMTP_STARTTLS=false

# Giden e-postaların gönderen adresi.
BAHCEDEN_MAIL_FROM=bahceden@ornek.test

# ── Kimlik (ADR-008) ────────────────────────────────────────
# Erişim token'ı (JWT) imza anahtarı: Base64 kodlu, en az 32 bayt (256 bit).
# Üretmek için: openssl rand -base64 32
# Eksik, kısa veya Base64 olmayan değerle uygulama açılmaz. Anahtar değişirse
# tüm erişim token'ları geçersiz olur (en fazla 15 dakikalık kesinti).
BAHCEDEN_JWT_SECRET=degistirin-bu-degeri

# ── Profil ──────────────────────────────────────────────────
# dev: geliştirme verisi (seed) yüklenir. Üretimde bu profil kullanılmaz.
SPRING_PROFILES_ACTIVE=dev
