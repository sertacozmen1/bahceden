# Bahçeden API: ortam değişkenleri (ÖRNEK DOSYA)
#
# Bu dosya depoya girer ve yalnızca PLACEHOLDER değer içerir. Gerçek değerler
# `.env` dosyasına yazılır ve `.env` gitignore'dadır: ne commit'e ne AI
# bağlamına girer (AGENTS.md K10).
#
# Her değişken tanımsızsa uygulama ayağa kalkmaz; varsayılan secret yoktur.

# ── Veritabanı ──────────────────────────────────────────────
# Geliştirmede docker-compose bu değerleri kendi içinde tanımlar; aşağıdaki
# örnek, api'yi compose dışında çalıştırmak isteyenler içindir.
BAHCEDEN_DB_URL=jdbc:postgresql://localhost:5432/bahceden
BAHCEDEN_DB_USERNAME=bahceden
BAHCEDEN_DB_PASSWORD=degistirin-bu-degeri

# ── CORS ────────────────────────────────────────────────────
# web uygulamasının adresi. Joker karakter (*) kullanılmaz (AGENTS.md §11.6).
BAHCEDEN_WEB_ORIGIN=http://localhost:3000

# ── Profil ──────────────────────────────────────────────────
# dev: geliştirme verisi (seed) yüklenir. Üretimde bu profil kullanılmaz.
SPRING_PROFILES_ACTIVE=dev
