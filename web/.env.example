# Bu değişken yalnızca SUNUCU tarafında okunur: tarayıcıya gönderilmez.
# Tarayıcıya açılması gereken (ve gizli olmayan) değerler NEXT_PUBLIC_ öneki
# ile açıkça işaretlenir.
BAHCEDEN_API_BASE_URL=http://localhost:8080
